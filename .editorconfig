root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable
# Fakes in :core:testing expose state via Flow-returning interface methods, not a mirrored
# public property, so `_foo` backing fields intentionally have no public `foo` counterpart.
ktlint_standard_backing-property-naming = disabled

[*.{xml,yml,yaml,json}]
indent_size = 2
